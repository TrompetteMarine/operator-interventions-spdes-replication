import RequestProject.OUMoments

/-!
# Exact finite-modal OU information identities

This file formalizes the deterministic score-coefficient and mean-information
identities used in Proposition 9.14.  It is kept separate from asymptotic CLT
claims.
-/

namespace OperatorInterventions

noncomputable section

/-- Derivative coefficient of the exact transition mean with respect to drift. -/
def ouRhoDriftDerivative (theta lambda delta : ℝ) : ℝ :=
  -lambda * delta * ouRho theta lambda delta

/-
The declared coefficient is the actual derivative of the exact transition
coefficient.
-/
theorem hasDerivAt_ouRho (theta lambda delta : ℝ) :
    HasDerivAt (fun t => ouRho t lambda delta)
      (ouRhoDriftDerivative theta lambda delta) theta := by
  unfold ouRhoDriftDerivative
  have h := ((hasDerivAt_id theta).const_mul (-lambda * delta)).exp
  convert h using 1
  · funext t
    simp only [id_eq, ouRho]
    congr 1
    ring
  · simp only [id_eq, ouRho]
    ring_nf

/-- Log-variance drift coefficient from equation (65). -/
def ouLogInnovationDriftDerivative (theta lambda delta : ℝ) : ℝ :=
  (2 * lambda * delta) / (Real.exp (2 * theta * lambda * delta) - 1) - 1 / theta

/-
Equation (65): the declared coefficient differentiates the logarithm of
the exact innovation factor on the positive parameter core.
-/
theorem hasDerivAt_log_ouInnovationFactor
    {theta lambda delta : ℝ} (htheta : 0 < theta)
    (hlambda : 0 < lambda) (hdelta : 0 < delta) :
    HasDerivAt (fun t => Real.log (ouInnovationFactor t lambda delta))
      (ouLogInnovationDriftDerivative theta lambda delta) theta := by
  convert HasDerivAt.log ( show HasDerivAt ( fun t => ( 1 - Real.exp ( -2 * t *lambda * delta ) ) / ( 2 * t *lambda ) ) _ _ from ?_ ) _ using 1 <;> norm_num;
  rotate_left;
  exact ( 2 * lambda * delta * Real.exp ( - ( 2 * theta * lambda * delta ) ) * ( 2 * theta * lambda ) - ( 1 - Real.exp ( - ( 2 * theta * lambda * delta ) ) ) * ( 2 * lambda ) ) / ( 2 * theta * lambda ) ^ 2;
  · convert HasDerivAt.div ( HasDerivAt.sub ( hasDerivAt_const _ _ ) ( HasDerivAt.exp ( HasDerivAt.neg ( HasDerivAt.mul ( HasDerivAt.mul ( HasDerivAt.mul ( hasDerivAt_const _ _ ) ( hasDerivAt_id theta ) ) ( hasDerivAt_const _ _ ) ) ( hasDerivAt_const _ _ ) ) ) ) ) ( HasDerivAt.mul ( HasDerivAt.mul ( hasDerivAt_const _ _ ) ( hasDerivAt_id theta ) ) ( hasDerivAt_const _ _ ) ) _ using 1 <;> norm_num [ htheta.ne', hlambda.ne', hdelta.ne' ] ; ring;
  · exact ⟨ ne_of_gt ( by norm_num; positivity ), htheta.ne', hlambda.ne' ⟩;
  · unfold ouLogInnovationDriftDerivative;
    rw [ Real.exp_neg ];
    field_simp;
    rw [ sub_div, div_self ( ne_of_gt ( by norm_num; positivity ) ) ]

/-- Mean-component Fisher information for one mode, summed over `n`
transitions using the exact deterministic second moments. -/
def ouModeMeanInformation
    (theta v q lambda delta u0 : ℝ) (n : ℕ) : ℝ :=
  ∑ j ∈ Finset.range n,
    (ouRhoDriftDerivative theta lambda delta) ^ 2 *
      ouSecondMoment theta v q lambda delta u0 j /
        (v * q ^ 2 * ouInnovationFactor theta lambda delta)

/-
Closed form of the exact modal mean-information sum, corresponding to the
modewise summand in equation (71).
-/
theorem ouModeMeanInformation_closed_form
    (theta v q lambda delta u0 : ℝ) (n : ℕ) :
    ouModeMeanInformation theta v q lambda delta u0 n =
      (ouRhoDriftDerivative theta lambda delta) ^ 2 /
        (v * q ^ 2 * ouInnovationFactor theta lambda delta) *
          (u0 ^ 2 * ouGeometricSum theta lambda delta n +
            ouStationaryVariance theta v q lambda *
              ((n : ℝ) - ouGeometricSum theta lambda delta n)) := by
  convert congr_arg _ ( sum_ouSecondMoment theta v q lambda delta u0 n ) using 1;
  unfold ouModeMeanInformation; rw [ Finset.mul_sum _ _ _ ] ; congr; ext; ring;

/-
Exact variance-score information for `n` Gaussian transitions when the
parameter is the standard-deviation scale `σ`.
-/
theorem gaussian_scale_information_sum
    (sigma : ℝ) (n : ℕ) :
    ∑ _j ∈ Finset.range n, (2 / sigma ^ 2 : ℝ) =
      2 * n / sigma ^ 2 := by
  simp +decide [div_eq_mul_inv, mul_comm, mul_left_comm]

/-
Exact variance-part drift information for one mode: each transition
contributes one half the squared log-variance derivative.
-/
theorem gaussian_variance_drift_information_sum
    (g : ℝ) (n : ℕ) :
    ∑ _j ∈ Finset.range n, (g ^ 2 / 2 : ℝ) =
      (n : ℝ) * g ^ 2 / 2 := by
  simp +decide [ mul_div_assoc ]

/-
Exact drift/scale cross-information generated by a parameter-dependent
variance over `n` transitions.
-/
theorem gaussian_drift_scale_cross_information_sum
    (g sigma : ℝ) (n : ℕ) :
    ∑ _j ∈ Finset.range n, (g / sigma : ℝ) =
      (n : ℝ) * g / sigma := by
  simp +decide [ mul_div_assoc ]

end

end OperatorInterventions