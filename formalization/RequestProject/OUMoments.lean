import RequestProject.OUKLDivergence

/-!
# Exact modal OU moment algebra

This file formalizes the deterministic moment recurrences behind equations
(69)--(71) and the modal second-moment inputs to Lemma 9.7.  Random variables
are not replaced by assumptions: the statements identify the unique moment
sequence generated by the exact affine Gaussian transition recurrence.
-/

namespace OperatorInterventions

noncomputable section

/-- Stationary modal variance under variance scale `v = σ²`. -/
def ouStationaryVariance (theta v q lambda : ℝ) : ℝ :=
  v * q ^ 2 / (2 * theta * lambda)

/-- Exact second moment after `j` transitions from deterministic initial value
`u0`, in closed form. -/
def ouSecondMoment
    (theta v q lambda delta u0 : ℝ) (j : ℕ) : ℝ :=
  (ouRho theta lambda delta) ^ (2 * j) * u0 ^ 2 +
    ouStationaryVariance theta v q lambda *
      (1 - (ouRho theta lambda delta) ^ (2 * j))

/-
The exact innovation variance equals stationary variance times
`1 - ρ²`.
-/
theorem ou_innovation_variance_stationary_identity
    (theta v q lambda delta : ℝ) :
    v * q ^ 2 * ouInnovationFactor theta lambda delta =
      ouStationaryVariance theta v q lambda *
        (1 - (ouRho theta lambda delta) ^ 2) := by
  unfold ouInnovationFactor ouStationaryVariance ouRho;
  rw [← Real.exp_nat_mul]
  ring_nf

/-
Closed-form second moments satisfy the exact affine OU recurrence.
-/
theorem ouSecondMoment_succ
    (theta v q lambda delta u0 : ℝ) (j : ℕ) :
    ouSecondMoment theta v q lambda delta u0 (j + 1) =
      (ouRho theta lambda delta) ^ 2 *
          ouSecondMoment theta v q lambda delta u0 j +
        v * q ^ 2 * ouInnovationFactor theta lambda delta := by
  unfold ouSecondMoment;
  rw [ou_innovation_variance_stationary_identity] ; ring

/-
The closed form has the prescribed deterministic initial moment.
-/
theorem ouSecondMoment_zero
    (theta v q lambda delta u0 : ℝ) :
    ouSecondMoment theta v q lambda delta u0 0 = u0 ^ 2 := by
  unfold ouSecondMoment; norm_num;

/-
Uniqueness of the exact modal second-moment recurrence.
-/
theorem ouSecondMoment_eq_of_recurrence
    {theta v q lambda delta u0 : ℝ}
    (m : ℕ → ℝ) (hzero : m 0 = u0 ^ 2)
    (hsucc : ∀ j, m (j + 1) =
      (ouRho theta lambda delta) ^ 2 * m j +
        v * q ^ 2 * ouInnovationFactor theta lambda delta) :
    ∀ j, m j = ouSecondMoment theta v q lambda delta u0 j := by
  intro j;
  induction' j with j ih;
  · exact hzero.trans ( ouSecondMoment_zero _ _ _ _ _ _ ▸ rfl );
  · convert hsucc j using 1;
    rw [ih, ouSecondMoment_succ]

/-
In the positive-parameter regime, exact modal second moments are
nonnegative.
-/
theorem ouSecondMoment_nonneg
    {theta v q lambda delta u0 : ℝ}
    (htheta : 0 < theta) (hv : 0 ≤ v) (hlambda : 0 < lambda)
    (hdelta : 0 ≤ delta) (j : ℕ) :
    0 ≤ ouSecondMoment theta v q lambda delta u0 j := by
  apply_rules [ add_nonneg, pow_mul, pow_two_nonneg ];
  · exact mul_nonneg ( pow_mul ( Real.exp _ ) 2 j ▸ by positivity ) ( sq_nonneg _ );
  · refine mul_nonneg ?_ ?_;
    · exact div_nonneg ( mul_nonneg hv ( sq_nonneg _ ) ) ( mul_nonneg ( mul_nonneg zero_le_two htheta.le ) hlambda.le );
    · exact sub_nonneg_of_le ( pow_le_one₀ ( by exact Real.exp_nonneg _ ) ( Real.exp_le_one_iff.mpr ( by nlinarith [ mul_nonneg htheta.le hlambda.le ] ) ) )

/-
With positive scale and mesh, every second moment after at least one
transition has a strictly positive innovation-generated lower bound.
-/
theorem ouSecondMoment_pos_of_pos_time
    {theta v q lambda delta u0 : ℝ}
    (htheta : 0 < theta) (hv : 0 < v) (hq : 0 < q)
    (hlambda : 0 < lambda) (hdelta : 0 < delta)
    {j : ℕ} (hj : 0 < j) :
    0 < ouSecondMoment theta v q lambda delta u0 j := by
  refine' add_pos_of_nonneg_of_pos _ _;
  · exact mul_nonneg ( pow_mul ( Real.exp _ ) 2 j ▸ by positivity ) ( sq_nonneg _ );
  · refine' mul_pos _ _;
    · exact div_pos ( mul_pos hv ( sq_pos_of_pos hq ) ) ( mul_pos ( mul_pos two_pos htheta ) hlambda );
    · exact sub_pos_of_lt ( pow_lt_one₀ ( by exact Real.exp_nonneg _ ) ( by exact Real.exp_lt_one_iff.mpr ( by nlinarith [ mul_pos htheta hlambda ] ) ) ( by positivity ) )

/-- Finite geometric sum used in the exact information formula. -/
def ouGeometricSum (theta lambda delta : ℝ) (n : ℕ) : ℝ :=
  ∑ j ∈ Finset.range n, (ouRho theta lambda delta) ^ (2 * j)

/-
Exact sum of modal second moments over the observation times.
-/
theorem sum_ouSecondMoment
    (theta v q lambda delta u0 : ℝ) (n : ℕ) :
    (∑ j ∈ Finset.range n, ouSecondMoment theta v q lambda delta u0 j) =
      u0 ^ 2 * ouGeometricSum theta lambda delta n +
        ouStationaryVariance theta v q lambda *
          ((n : ℝ) - ouGeometricSum theta lambda delta n) := by
  unfold ouSecondMoment ouGeometricSum;
  simp +decide [mul_sub, mul_comm, Finset.mul_sum _ _ _, Finset.sum_add_distrib];
  simp +decide [ sub_mul, Finset.sum_sub_distrib ]

/-
Closed form for the finite geometric sum when the transition coefficient
is not one.
-/
theorem ouGeometricSum_closed_form
    {theta lambda delta : ℝ} (n : ℕ)
    (hne : (ouRho theta lambda delta) ^ 2 ≠ 1) :
    ouGeometricSum theta lambda delta n =
      (1 - (ouRho theta lambda delta) ^ (2 * n)) /
        (1 - (ouRho theta lambda delta) ^ 2) := by
  rw [ eq_div_iff, mul_comm ];
  · unfold ouGeometricSum;
    norm_num [ pow_mul, ← geom_sum_mul_neg ];
    ring;
  · exact sub_ne_zero_of_ne hne.symm

end

end OperatorInterventions